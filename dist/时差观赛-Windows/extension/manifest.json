{
  "manifest_version": 3,
  "name": "时差观赛助手",
  "version": "0.2.11",
  "description": "隐藏复播页面中可能包含剧透的信息，帮助用户用时差观赛方式观看官方复播。",
  "update_url": "https://scgs.tv/public/updates.xml",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "host_permissions": [
    "https://scgs.tv/*",
    "https://www.scgs.tv/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*",
    "https://*.cctv.com/*",
    "https://*.cntv.cn/*",
    "https://*.yangshipin.cn/*",
    "https://*.xiaohongshu.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://scgs.tv/*",
        "https://www.scgs.tv/*",
        "http://localhost:*/*",
        "http://127.0.0.1:*/*",
        "https://*.cctv.com/*",
        "https://*.cntv.cn/*",
        "https://*.yangshipin.cn/*",
        "https://*.xiaohongshu.com/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
